# LF in the repository AND in every checkout, on every OS, so a Windows (autocrlf) checkout and a
# Linux checkout build byte-identical sdist/wheel files (setuptools reads the working tree).
* text=auto eol=lf

# Binary: never normalised, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.whl binary
*.db binary
*.sqlite binary
*.parquet binary
